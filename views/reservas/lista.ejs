<header class="cabecera-pagina">
 <div>
 <p class="etiqueta"><%= seccion %></p>
 <h1><%= titulo %></h1>
 </div>
 <a class="boton" href="/inscripciones/nueva">Nueva Inscripcion</a>
 </header>
<% if (inscripciones.length === 0) { %>
 <p>No hay inscripciones registradas</p>
<% } else { %>
 <section class="grilla" aria-label="Inscripciones registradas">
 <% inscripciones.forEach((inscripcion) => { %>
 <article class="tarjeta">

 <h2><%= inscripcion.participante %></h2>
 <p><%= inscripcion.recorrido %></p>
 <p><%= inscripcion.fecha %> - <%= inscripcion.lugares %> lugar(es)</p>
<a href="/inscripciones/<%= inscripcion.id %>">Ver detalle</a>

 </article>
 <% }) %>
 </section>
<% } %>

