<section class="panel-formulario">
 <p class="etiqueta">NUEVO INGRESO</p>
 <h1><%= titulo %></h1>
 <% if (error) { %>
 <p class="error" role="alert"><%= error %></p>
 <% } %>
 <form action="/productos" method="post" class="formulario">
 <label for="nombre">Nombre</label>
 <input id="nombre" name="nombre" value="<%= valores.nombre ?? '' %>" required>
 <label for="categoria">Categoría</label>
 <input id="categoria" name="categoria" value="<%= valores.categoria ?? '' %>" required>
 <label for="precio">Precio</label>
 <input id="precio" name="precio" type="number" min="1" step="1" value="<%= valores.precio ?? '' %>"
required>
 <label for="descripcion">Descripción</label>
 <textarea id="descripcion" name="descripcion" rows="5" required><%= valores.descripcion ?? '' %></textarea>
 <button type="submit">Guardar producto</button>
 </form>
</section>