<header class="cabecera-pagina">
 <div>
 <p class="etiqueta">CATÁLOGO</p>
 <h1><%= titulo %></h1>
 </div>
 <a class="boton" href="/productos/nuevo">Agregar producto</a>
 </header>
<% if (productos.length === 0) { %>
 <p>No hay productos para mostrar.</p>
<% } else { %>
 <section class="grilla" aria-label="Productos disponibles">
 <% productos.forEach((producto) => { %>
 <article class="tarjeta">
 <p class="etiqueta"><%= producto.categoria %></p>
 <h2><%= producto.nombre %></h2>
 <p class="precio">$<%= producto.precio.toLocaleString("es-AR") %></p>
 <a href="/productos/<%= producto.id %>">Ver detalle</a>
 </article>
 <% }) %>
 </section>
<% } %>